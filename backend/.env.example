# DRISHTI Backend Environment Configuration Template
# Copy this file to .env and provide your secrets locally.
# NEVER COMMIT .env TO VERSION CONTROL.

# Application Environment
ENVIRONMENT=development
PORT=8000

# CORS Allowed Origins (Comma-separated for local, preview, and production domains)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,https://drishti.vercel.app

# Google Gemini API Key for Grounded Decision Intelligence Advisories
# Also used by the AI Flood Evidence Verification Layer (gemini_verifier.py)
# Optional: If not provided, DRISHTI automatically runs in calibrated DEMO_FALLBACK / ABSTAIN mode
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# =========================================================
# AI FLOOD EVIDENCE VERIFICATION LAYER (New Feature)
# =========================================================

# Google Earth Engine — for Sentinel-2 retrieval
# If not configured, verification defaults to ABSTAIN (fails safely)
# EE_SERVICE_ACCOUNT_KEY: path to service account JSON file, OR the JSON string itself
EE_SERVICE_ACCOUNT_KEY=
EE_PROJECT=

# Sentinel-2 Retrieval Settings (MVP engineering defaults)
S2_SEARCH_WINDOW_DAYS=14
S2_TILE_BUFFER_DEG=0.05
S2_RESOLUTION_M=20
S2_MAX_TILE_PIXELS=65536

# Cloud Gate Thresholds (MVP engineering defaults — NOT scientifically validated)
CLOUD_GATE_CLEAR_PCT=20
CLOUD_GATE_CLEAR_PROB=25
CLOUD_GATE_PARTIAL_PCT=50
CLOUD_GATE_PARTIAL_PROB=50

# Verification Policy Uncertainty Adjustments (±risk-score points)
# MVP engineering baselines — NOT scientifically calibrated values
VERIFICATION_AGREE_ADJ=0
VERIFICATION_PARTIAL_ADJ=5
VERIFICATION_DISAGREE_ADJ=15
VERIFICATION_ABSTAIN_ADJ=10

# Permanent Water Check
JRC_OCCURRENCE_THRESHOLD=80
PERM_WATER_OVERLAP_THRESHOLD=0.3
