# DRISHTI Backend Environment Configuration Template
# Copy this file to .env and provide your secrets locally.
# NEVER COMMIT .env TO VERSION CONTROL.

# Application Environment
ENVIRONMENT=development
PORT=8000

# CORS Allowed Origins (Comma-separated for local, preview, and production domains)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,https://drishti.vercel.app

# Google Gemini API Key for Grounded Decision Intelligence Advisories
# Optional: If not provided, DRISHTI automatically runs in calibrated DEMO_FALLBACK mode
GEMINI_API_KEY=
